# macOS
.DS_Store

# Bun
# No trailing slash: worktrees link node_modules from the main checkout.
node_modules

# Build output. `mise run acp:launcher` writes `.build/pico-acp` here; its shebang is
# the absolute path of this machine's Bun, so it is machine-local by construction.
.build/

# Local credentials
.env
.env.*

# mise — machine-local overrides and their lockfiles. mise.toml and mise.lock are committed.
mise.local.toml
mise.*.local.toml
.mise.local.toml
.mise/locks/mise.local/

# hk — machine-local hook overrides. hk.pkl is committed.
hk.local.pkl

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Tuist generates the Xcode project from Project.swift on demand; Project.swift is
# the source of truth and these are artifacts.
#
# Anchored with a leading slash: the generated project is always at the repository
# root, and an unanchored `*.xcodeproj/` also swallows the hand-managed
# `Prototype.xcodeproj` that `prototyping-apple-app-design` ships and copies into
# every new design prototype.
/*.xcodeproj/
/*.xcworkspace/
# Where Tuist writes the Info.plist and other inputs it derives for that project.
Derived/
